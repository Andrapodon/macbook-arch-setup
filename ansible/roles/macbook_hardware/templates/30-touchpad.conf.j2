Section "InputClass"
    Identifier "Apple MacBook Touchpad (Natural Scroll & Tap)"
    MatchIsTouchpad "on"
    Driver "libinput"
    Option "Tapping" "on"
    Option "NaturalScrolling" "true"
    Option "ClickMethod" "clickfinger"
    Option "ScrollMethod" "twofinger"
    Option "HorizontalScrolling" "true"
EndSection
